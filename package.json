{
	"name": "cpsc310-lecture-code",
	"description": "CPSC 310 lecture code. Run scripts from inside a project directory (one with src/ and test/).",
	"private": true,
	"version": "0.2.0",
	"engines": {
		"node": ">= 24 < 25"
	},
	"devDependencies": {
		"@tsconfig/node24": "24.0.1",
		"@types/chai": "4.3.0",
		"@types/express": "5.0.3",
		"@types/mocha": "10.0.10",
		"@types/node": "24.3.0",
		"@types/supertest": "6.0.3",
		"chai": "4.3.4",
		"express": "5.1.0",
		"mocha": "11.7.1",
		"nyc": "17.1.0",
		"prettier": "3.6.2",
		"supertest": "7.1.4",
		"ts-node": "10.9.2",
		"typescript": "5.9.2"
	},
	"scripts": {
		"cover": "node scripts/run.mjs nyc --cwd . --reporter text --reporter html mocha",
		"build": "node scripts/typecheck.mjs && yarn prettier:check",
		"test": "node scripts/run.mjs mocha",
		"prettier:check": "node scripts/run.mjs prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
		"prettier:fix": "node scripts/run.mjs prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "node scripts/run.mjs ts-node src/main.ts"
	}
}
