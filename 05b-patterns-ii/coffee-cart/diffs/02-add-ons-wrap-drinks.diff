    REFACTOR-0002: menu drinks and add-ons are Drinks
    
    MenuDrink answers from the menu. Each add-on is a class that wraps
    another Drink and answers by changing that drink's answer: ExtraShot
    and Whip add to the end, and Large multiplies the price and goes in
    front of the name. AddOn holds the wrapped drink, so every add-on can
    wrap any Drink, including another add-on.
    
    Everything an add-on does is now in one class, instead of split
    between two switches. The cart doesn't use any of it yet.

diff --git a/src/addOns.ts b/src/addOns.ts
new file mode 100644
index 0000000..9328de2
--- /dev/null
+++ b/src/addOns.ts
@@ -0,0 +1,39 @@
+import { Drink } from "./Drink";
+
+/** Wraps a drink, and answers by changing the wrapped drink's answer. */
+export abstract class AddOn implements Drink {
+	constructor(protected drink: Drink) {}
+
+	abstract getDescription(): string;
+	abstract getPriceCents(): number;
+}
+
+export class ExtraShot extends AddOn {
+	getDescription(): string {
+		return this.drink.getDescription() + " + extra shot";
+	}
+
+	getPriceCents(): number {
+		return this.drink.getPriceCents() + 100;
+	}
+}
+
+export class Whip extends AddOn {
+	getDescription(): string {
+		return this.drink.getDescription() + " + whip";
+	}
+
+	getPriceCents(): number {
+		return this.drink.getPriceCents() + 50;
+	}
+}
+
+export class Large extends AddOn {
+	getDescription(): string {
+		return "Large " + this.drink.getDescription();
+	}
+
+	getPriceCents(): number {
+		return Math.round(this.drink.getPriceCents() * 1.5);
+	}
+}
