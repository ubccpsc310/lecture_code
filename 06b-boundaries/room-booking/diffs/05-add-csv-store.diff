+import { expect } from "chai";
+import * as fs from "fs";
+import * as os from "os";
+import * as path from "path";
+import { Booking } from "../../src/core/Booking";
+import { CsvBookingStore } from "../../src/adapters/CsvBookingStore";
+import { bookingStoreContract } from "../bookingStoreContract";
+
+const SAM_10_TO_12: Booking = { room: "IKB-261", student: "sam", date: "2026-11-03", start: "10:00", end: "12:00" };
+
+// Integration tests: a real CsvBookingStore, writing a real file in a fresh temporary directory.
+describe("CsvBookingStore", () => {
+	let file: string;
+
+	beforeEach(() => {
+		file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), "rooms-")), "bookings.csv");
+	});
+
+	afterEach(() => {
+		fs.rmSync(path.dirname(file), { recursive: true, force: true });
+	});
+
+	bookingStoreContract(() => new CsvBookingStore(file));
+
+	it("keeps bookings for the next store that opens the same file", () => {
+		new CsvBookingStore(file).add(SAM_10_TO_12);
+		expect(new CsvBookingStore(file).bookingsOn("2026-11-03")).to.deep.equal([SAM_10_TO_12]);
+	});
+
+	it("writes a header row, then one row per booking", () => {
+		new CsvBookingStore(file).add(SAM_10_TO_12);
+		expect(fs.readFileSync(file, "utf8")).to.equal("room,student,date,start,end\nIKB-261,sam,2026-11-03,10:00,12:00\n");
+	});
+});
