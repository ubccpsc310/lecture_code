 import { expect } from "chai";
-import { book } from "../src/bookings";
+import { book, FileSystem } from "../src/bookings";
 
-describe("book", () => {});
+/** Holds the bookings file in memory, and remembers what was last written to it. */
+class FakeFileSystem implements FileSystem {
+	public written: string | undefined;
+
+	constructor(private contents: string) {}
+
+	readFileSync(): string {
+		return this.contents;
+	}
+
+	writeFileSync(path: string, data: string): void {
+		this.written = data;
+	}
+}
+
+const SAM_10_TO_12 = `{ "room": "IKB-261", "student": "sam", "date": "2026-11-03", "start": "10:00", "end": "12:00" }`;
+const SAM_13_TO_14 = `{ "room": "IKB-263", "student": "sam", "date": "2026-11-03", "start": "13:00", "end": "14:00" }`;
+
+describe("book", () => {
+	it("books a free room", () => {
+		const files = new FakeFileSystem("[]");
+		expect(book(files, "IKB-261", "alex", "2026-11-03", "10:00", "12:00")).to.equal(
+			"Booked IKB-261 for alex on 2026-11-03, 10:00–12:00"
+		);
+		expect(JSON.parse(files.written!)).to.deep.equal([
+			{ room: "IKB-261", student: "alex", date: "2026-11-03", start: "10:00", end: "12:00" },
+		]);
+	});
+
+	it("refuses a booking longer than 2 hours", () => {
+		const files = new FakeFileSystem("[]");
+		expect(book(files, "IKB-261", "alex", "2026-11-03", "10:00", "12:01")).to.equal(
+			"Can't book: a room can be booked for at most 2 hours"
+		);
+		expect(files.written).to.be.undefined;
+	});
+
+	it("refuses a booking that overlaps another in the same room", () => {
+		const files = new FakeFileSystem(`[${SAM_10_TO_12}]`);
+		expect(book(files, "IKB-261", "alex", "2026-11-03", "11:59", "13:00")).to.equal(
+			"Can't book: IKB-261 is already booked 10:00–12:00"
+		);
+		expect(files.written).to.be.undefined;
+	});
+
+	it("books back-to-back with another booking", () => {
+		const files = new FakeFileSystem(`[${SAM_10_TO_12}]`);
+		expect(book(files, "IKB-261", "alex", "2026-11-03", "12:00", "13:00")).to.equal(
+			"Booked IKB-261 for alex on 2026-11-03, 12:00–13:00"
+		);
+		expect(JSON.parse(files.written!)).to.have.length(2);
+	});
+
+	it("refuses a student's third booking on the same day", () => {
+		const files = new FakeFileSystem(`[${SAM_10_TO_12}, ${SAM_13_TO_14}]`);
+		expect(book(files, "IKB-265", "sam", "2026-11-03", "15:00", "16:00")).to.equal(
+			"Can't book: sam already has 2 bookings on 2026-11-03"
+		);
+		expect(files.written).to.be.undefined;
+	});
+});
