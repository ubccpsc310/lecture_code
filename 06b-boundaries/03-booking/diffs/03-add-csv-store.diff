diff --git a/src/adapters/CsvBookingStore.ts b/src/adapters/CsvBookingStore.ts
new file mode 100644
index 0000000..8a3a490
--- /dev/null
+++ b/src/adapters/CsvBookingStore.ts
@@ -0,0 +1,36 @@
+import * as fs from "fs";
+import { Booking, BookingStore } from "../core/BookingStore";
+
+const HEADER = "room,student,date,start,end";
+
+/**
+ * Keeps bookings in a CSV file with a header row, so Facilities can open it in a spreadsheet.
+ * Rooms, students, dates and times never contain commas, so no field needs quoting.
+ */
+export class CsvBookingStore implements BookingStore {
+	constructor(private file: string) {}
+
+	bookingsFor(room: string, date: string): Booking[] {
+		return this.readAll().filter((each) => each.room === room && each.date === date);
+	}
+
+	add(booking: Booking): void {
+		if (!fs.existsSync(this.file)) {
+			fs.writeFileSync(this.file, HEADER + "\n");
+		}
+		const { room, student, date, start, end } = booking;
+		fs.appendFileSync(this.file, [room, student, date, start, end].join(",") + "\n");
+	}
+
+	private readAll(): Booking[] {
+		// nothing has been booked yet
+		if (!fs.existsSync(this.file)) {
+			return [];
+		}
+		const [, ...rows] = fs.readFileSync(this.file, "utf8").trim().split("\n");
+		return rows.map((row) => {
+			const [room, student, date, start, end] = row.split(",");
+			return { room, student, date, start, end };
+		});
+	}
+}
