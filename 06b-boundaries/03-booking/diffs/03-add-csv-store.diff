@@ -0,0 +1,32 @@
+import { expect } from "chai";
+import * as fs from "fs";
+import * as os from "os";
+import * as path from "path";
+import { Booking } from "../../src/core/BookingStore";
+import { CsvBookingStore } from "../../src/adapters/CsvBookingStore";
+
+/** A path to a file called bookings.csv, in a new, empty temporary directory. The file doesn't exist yet. */
+function tempFile(): string {
+	return path.join(fs.mkdtempSync(path.join(os.tmpdir(), "rooms-")), "bookings.csv");
+}
+
+const SAM_10_TO_12: Booking = { room: "IKB-261", student: "sam", date: "2026-11-03", start: "10:00", end: "12:00" };
+
+// Integration tests: a real CsvBookingStore, writing a real file in a temporary directory. No core.
+describe("CsvBookingStore", () => {
+	it("starts with no bookings", () => {
+		expect(new CsvBookingStore(tempFile()).bookingsFor("IKB-261", "2026-11-03")).to.deep.equal([]);
+	});
+
+	it("has a booking once it is added, even in a new store on the same file", () => {
+		const file = tempFile();
+		new CsvBookingStore(file).add(SAM_10_TO_12);
+		expect(new CsvBookingStore(file).bookingsFor("IKB-261", "2026-11-03")).to.deep.equal([SAM_10_TO_12]);
+	});
+
+	it("writes a header row, then one row per booking", () => {
+		const file = tempFile();
+		new CsvBookingStore(file).add(SAM_10_TO_12);
+		expect(fs.readFileSync(file, "utf8")).to.equal("room,student,date,start,end\nIKB-261,sam,2026-11-03,10:00,12:00\n");
+	});
+});
