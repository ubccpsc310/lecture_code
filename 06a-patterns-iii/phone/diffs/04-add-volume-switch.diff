    FEAT-0002: add volume buttons to the switch version
    
    The phone gets volume up and volume down buttons. They do nothing while
    the phone is off, and change the volume between 0 and 10 while it is
    locked or ready.
    
    Phone already switches over its state in every event, so each button is
    one new method with one switch: a case for every state, written next to
    each other. Nothing else in the class changed.
    
    This is the change the switch version is open to. Compare it with the
    same buttons in the State version.

diff --git a/src/Phone.ts b/src/Phone.ts
index a6cf6eb..7a6b92f 100644
--- a/src/Phone.ts
+++ b/src/Phone.ts
@@ -1,5 +1,6 @@
 export class Phone {
 	private state: "off" | "locked" | "ready" = "off";
+	private volume = 5;
 
 	constructor(private fingerprint: string) {}
 
@@ -48,4 +49,37 @@ export class Phone {
 				break;
 		}
 	}
+
+	pressVolumeUp(): void {
+		switch (this.state) {
+			case "off":
+				console.log("  Nothing happens: the phone is off.");
+				break;
+			case "locked":
+				this.changeVolume(1);
+				break;
+			case "ready":
+				this.changeVolume(1);
+				break;
+		}
+	}
+
+	pressVolumeDown(): void {
+		switch (this.state) {
+			case "off":
+				console.log("  Nothing happens: the phone is off.");
+				break;
+			case "locked":
+				this.changeVolume(-1);
+				break;
+			case "ready":
+				this.changeVolume(-1);
+				break;
+		}
+	}
+
+	private changeVolume(by: number): void {
+		this.volume = Math.max(0, Math.min(10, this.volume + by));
+		console.log(`  🔊 Volume ${this.volume}`);
+	}
 }
