 	private state: PhoneState = new OffState(this);
+	private volume = 5;
 
 	constructor(private fingerprint: string) {}
 
@@ -14,6 +15,11 @@ export class Phone {
 		return finger === this.fingerprint;
 	}
 
+	changeVolume(by: number): void {
+		this.volume = Math.max(0, Math.min(10, this.volume + by));
+		console.log(`  🔊 Volume ${this.volume}`);
+	}
+
 	pressPower(): void {
 		this.state.pressPower();
 	}
@@ -25,4 +31,12 @@ export class Phone {
 	receiveNotification(app: string, text: string): void {
 		this.state.receiveNotification(app, text);
 	}
+
+	pressVolumeUp(): void {
+		this.state.pressVolumeUp();
+	}
+
+	pressVolumeDown(): void {
+		this.state.pressVolumeDown();
+	}
 }
