--- a/src/Customer.ts
+++ b/src/Customer.ts
@@ -11,6 +11,7 @@ export class Customer {

 	public get status(): string {
 		if (this.interests.length >= 5) return "Community Champion";
+		if (this.interests.length >= 4) return "Community Enthusiast";
 		if (this.interests.length >= 3) return "Frequent Customer";
 		return "Default";
 	}
