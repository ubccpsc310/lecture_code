--- a/test/parkboard.spec.ts
+++ b/test/parkboard.spec.ts
@@ -233,6 +233,11 @@ describe("loyalty", () => {
 		findOffering("AR-105-A")!.register(customer("c05"));
 		expect(customer("c05").interests.length).to.equal(before);
 	});
+
+	it("Test 42f: promotes a customer who has taken four", () => {
+		expect(customer("c03").interests).to.have.length(4);
+		expect(customer("c03").status).to.equal("Community Enthusiast");
+	});
 });

